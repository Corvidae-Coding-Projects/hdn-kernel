# SPDX-License-Identifier: GPL-2.0-only
# Policy used by the QEMU smoke test to prove contained chroots deny mount
# operations even when the profile otherwise has mount administration.

generation 1
base 0
default 1
privileged 2

profile 1 default
profile 2 chroot-mount-root

allow 2 MOUNT_ADMIN POLICY_ADMIN CRED_CHANGE TTY_ACCESS
feature 2 CHROOT_CONTAINED
