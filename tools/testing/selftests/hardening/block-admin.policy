# SPDX-License-Identifier: GPL-2.0-only
# Policy used by the QEMU smoke test to prove that raw block-device
# inspection can be allowed without allowing block-device administration.

generation 1
base 0
default 1
privileged 2

profile 1 default
profile 2 block-inspector

allow 2 POLICY_ADMIN CRED_CHANGE TTY_ACCESS BLOCK_DEVICE_ACCESS
