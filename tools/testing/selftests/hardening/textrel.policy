# SPDX-License-Identifier: GPL-2.0-only
# Root-profile policy used by the QEMU smoke test to prove that text
# relocation compatibility is explicit instead of ambient.

generation 1
base 0
default 1
privileged 2

profile 1 default
profile 2 textrel-root

allow 2 POLICY_ADMIN CRED_CHANGE TTY_ACCESS
mem 2 ALLOW_TEXTREL_MPROTECT
