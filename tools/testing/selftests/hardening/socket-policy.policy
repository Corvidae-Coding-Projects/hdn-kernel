# Policy used by the QEMU smoke test to prove socket create, client, and
# server authorities remain independently enforceable.

generation 1
base 0
default 1
privileged 2

profile 1 default
profile 2 socket-root

allow 2 POLICY_ADMIN CRED_CHANGE TTY_ACCESS SOCKET_CREATE
