# SPDX-License-Identifier: GPL-2.0-only
# Policy used by the QEMU smoke test to prove pidfd-backed namespace joins
# still require task visibility even when namespace administration is granted.

generation 1
base 0
default 1
privileged 2

profile 1 default
profile 2 namespace-root

allow 2 POLICY_ADMIN CRED_CHANGE TTY_ACCESS PTRACE NAMESPACE_ADMIN
